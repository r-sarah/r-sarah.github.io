# Copier vers .env.local à la racine du repo pour `vercel dev` (ne pas committer .env.local)
#
# Clé factice (sk-xxxx, etc.) = mode démo sans appeler OpenAI.
# Vraie clé : https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-xxxxREPLACE_ME_WHEN_READY

# OPENAI_USE_MOCK=1

OPENAI_MODEL=gpt-4o-mini

# Origine exacte de votre portfolio (GitHub Pages). Ex. : https://votrepseudo.github.io
CHAT_ALLOWED_ORIGIN=https://votrepseudo.github.io

# Optionnel : votre pitch / CV court pour le prompt système
# PORTFOLIO_CONTEXT=
